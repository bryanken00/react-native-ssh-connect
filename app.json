{
  "expo": {
    "name": "Expo Template",
    "slug": "expo-template",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.example.apptemplate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6750A4"
      }
    },
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.example.apptemplate"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photo library.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
