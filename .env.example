# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time.
# That means these values ship inside the app and are readable by anyone who
# unpacks it — put API hosts and feature flags here, NEVER secrets, API keys
# or credentials.
#
# Changing this file requires a bundler restart: npx expo start --clear

# Base URL of your API. On a physical device, localhost is the device itself —
# use your machine's LAN IP (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Demo mode. When "true", auth resolves locally and makes NO network calls —
# any non-empty email and password signs you in as a fake user, and the login
# screen shows an amber "Demo mode" badge so it cannot be mistaken for a real
# session. Useful for exploring the template or building UI before a backend
# exists. Must be exactly "true"; anything else (including "1") is off.
#
# Turn this off before shipping. Fixtures live in src/constants/demo.js.
EXPO_PUBLIC_DEMO_MODE=false
